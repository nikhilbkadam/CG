line(v.back().x, v.back().y, v[0].x, v[0].y);
for (auto &p : v) rectangle(p.x - 2, p.y - 2, p.x + 2, p.y + 2); // vertex markers
}
void redraw() {
setbkcolor(WHITE);
cleardevice();
setcolor(BLUE);
rectangle(WXL, WYL, WXR, WYR); // clipping window
setcolor(DARKGRAY);
rectangle(VXL, VYL, VXR, VYR); // viewport border
setcolor(BLACK);
outtextxy(10, 10, "L-click: vertex | R-click: close | c: clip | r: reset | Arrows: move | Esc: exit");
outtextxy(450, 10, "Viewport");
drawPolyPts(poly, closed, BLACK); // original polygon in black
if (closed && !clipped.empty()) {
drawPolyPts(clipped, true, RED); // clipped polygon in red (window)
vector<Pt> vp;
for (auto &p : clipped) vp.push_back(w2v(p));
drawPolyPts(vp, true, RED); // mapped into viewport
}
}
int main() {
int gd = DETECT, gm;
initgraph(&gd, &gm, NULL);
initmouse();
showmouseptr();
cout << "Draw the polygon with the mouse in the graphics window.\n";
redraw();
while (true) {
if (ismouseclick(WM_LBUTTONDOWN)) {
int x, y;
getmouseclick(WM_LBUTTONDOWN, x, y);
if (!closed && x < 400) { poly.push_back({x, y}); redraw(); }
}
if (ismouseclick(WM_RBUTTONDOWN)) {
int x, y;
getmouseclick(WM_RBUTTONDOWN, x, y);
if (!closed && poly.size() >= 3) { closed = true; redraw(); }
}
if (kbhit()) {
int ch = getch();
if (ch == 0) ch = getch(); // extended key (arrows)
if (ch == 'c' || ch == 'C') { if (closed) { doClip(); redraw(); } }
else if (ch == 'r' || ch == 'R') {
poly.clear(); clipped.clear(); closed = false; redraw();
}
else if (ch == 75) { WXL -= 10; WXR -= 10; if (closed) doClip(); redraw(); }
else if (ch == 77) { WXL += 10; WXR += 10; if (closed) doClip(); redraw(); }
else if (ch == 72) { WYL -= 10; WYR -= 10; if (closed) doClip(); redraw(); }
else if (ch == 80) { WYL += 10; WYR += 10; if (closed) doClip(); redraw(); }
else if (ch == 27) break; // Esc
}
}
closegraph();
return 0;
}
